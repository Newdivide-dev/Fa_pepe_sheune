<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.music.MainController">
    <children>
        <VBox prefWidth="220.0" spacing="15.0" styleClass="side-bar" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="SoundWave" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold; -fx-padding: 0 0 20 0;"/>
                <Label fx:id="currentUserLabel" style="-fx-text-fill: #1DB954; -fx-font-size: 14; -fx-padding: 0 0 10 0;"/>

                <Button maxWidth="Infinity" onAction="#handleImport" text="Импорт треков" />
                <Button maxWidth="Infinity" onAction="#handleCreatePlaylist" text="Создать плейлист" />
                <Button maxWidth="Infinity" onAction="#handleDeleteTrack" text="Удалить трек" />
                <Button maxWidth="Infinity" onAction="#handleLogout" text="Выйти" style="-fx-text-fill: #ff5252;"/>
            </children>
        </VBox>
        <TextField fx:id="searchField" promptText="🔍 Поиск треков..." layoutX="230.0" layoutY="15.0" prefWidth="450.0" />
        <TableView fx:id="tracksTable" layoutX="230.0" layoutY="55.0" prefHeight="400.0" prefWidth="650.0" AnchorPane.bottomAnchor="130.0" AnchorPane.leftAnchor="230.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="55.0">
            <columns>
                <TableColumn fx:id="titleColumn" prefWidth="320.0" text="НАЗВАНИЕ" />
                <TableColumn fx:id="artistColumn" prefWidth="310.0" text="ИСПОЛНИТЕЛЬ" />
            </columns>
        </TableView>
        <VBox alignment="CENTER" layoutY="500.0" prefHeight="100.0" spacing="10.0" style="-fx-background-color: #181818;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <HBox alignment="CENTER" spacing="10.0">
                    <Label fx:id="timeCurrent" text="0:00" style="-fx-text-fill: #b3b3b3;"/>
                    <Slider fx:id="progressSlider" prefWidth="450.0" />
                    <Label fx:id="timeTotal" text="0:00" style="-fx-text-fill: #b3b3b3;"/>
                </HBox>

                <HBox alignment="CENTER" spacing="20.0">
                    <Button onAction="#handlePrev" text="⏮" style="-fx-background-color: transparent; -fx-font-size: 22;"/>
                    <Button onAction="#handlePlayPause" prefHeight="60.0" prefWidth="60.0" styleClass="play-button" text="▶" />
                    <Button onAction="#handleNext" text="⏭" style="-fx-background-color: transparent; -fx-font-size: 22;"/>

                    <HBox spacing="8.0" alignment="CENTER">
                        <Label text="🔊" style="-fx-text-fill: #b3b3b3;"/>
                        <Slider fx:id="volumeSlider" prefWidth="140.0" min="0" max="100" />
                    </HBox>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>